# 站点源码存档：仅用于研究规则，不随仓库发布
recon/

# 数据集切分产物：由 tools/build_dataset.py 从 raw_assets/ 确定性重建（固定 seed），
# 避免把同一批图片在仓库里存两遍；dataset/manifest.json 入库保留划分记录
dataset/cls/
dataset/det/
dataset/labelImg/

# 运行时产物
logs/
shots/
# 录像默认不入库（`.mp4` 体积大）；只放行完整通关那一条，交付时要能直接看见证据
*.mp4
!demo/part3_perfect_25of25.mp4
!demo/part3_perfect_25of25_b.mp4
!demo/part1_perfect_25of25.mp4
!demo/part3_perfect_25of25_c.mp4
__pycache__/
*.pyc

# 训练中间产物（runs/ 里的 weights 与曲线要保留，这里只忽略缓存）
runs/**/*.cache

# 图库原图（raw_assets/，748 张）按考核要求入库，不忽略

runs/**/weights/last.pt

# 失败实验的权重（各 52 MB，超过 GitHub 推荐上限）；结论已写进 README，文件本身不入库
runs/cls_crops/weights/best.pt
runs/cls_real/weights/best.pt

# IDE
.idea/
