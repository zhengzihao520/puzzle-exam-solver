# 站点源码存档：仅用于研究规则，不随仓库发布
recon/

# 数据集切分产物：由 tools/build_dataset.py 从 raw_assets/ 确定性重建（固定 seed），
# 避免把同一批图片在仓库里存两遍；dataset/manifest.json 入库保留划分记录
dataset/cls/
dataset/det/
dataset/labelImg/

# 运行时产物。用 `logs/*` 而不是 `logs/`：目录被排除后，里面的白名单会失效（git 的规则）
logs/*
# ... 但 README 引用的那份实测日志要能直接看到（25 步 0 拒绝那一局）
!logs/part3_25moves_25of25.log
shots/

# 录像默认不入库（`.mp4` 体积大）；只放行完整通关的那几条，交付时要能直接看见证据
*.mp4
!demo/part3_perfect_25of25.mp4
!demo/part3_perfect_25of25_b.mp4
!demo/part3_43moves_25of25.mp4
!demo/part3_flat_order_25of25.mp4
!demo/part1_perfect_25of25.mp4
!demo/part3_perfect_25of25_c.mp4

__pycache__/
*.pyc

# 训练中间产物（runs/ 里的 weights 与曲线要保留，这里只忽略缓存与 last.pt）
runs/**/*.cache
runs/**/weights/last.pt

# 图库原图（raw_assets/，750 张）按考核要求入库，不忽略

# white-cell capture frames (debug flag --white-frames)
runs/white/

# 讲解/注释副本（本地学习用，不入库）
docs/study/

# IDE
.idea/
